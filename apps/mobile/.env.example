# Copia este archivo a .env.local (ignorado por git).
# Origen del backend de PEI, sin /api/auth ni barra final.
# En un dispositivo físico usa la IP de tu equipo en la red local, no localhost.
# Emulador de Android: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# F4 Payments: clave PUBLICABLE de Stripe (pk_test_… en el periodo académico; solo modo de prueba). Nunca la clave
# secreta (sk_…) ni una restringida (rk_…): EXPO_PUBLIC_* se inserta en el bundle.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
