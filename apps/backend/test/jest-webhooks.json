{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "setupFiles": [
    "<rootDir>/test/support/db-tripwire.ts",
    "<rootDir>/test/support/c2-mode-webhooks.ts"
  ],
  "testRegex": "test/webhooks/.*\\.wh-spec\\.ts$",
  "testTimeout": 120000,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
