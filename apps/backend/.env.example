# Variables del backend de PEI. Copiar a .env y completar; nunca versionar valores reales.

# PostgreSQL (Neon)
DATABASE_URL=

# Better Auth
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Orígenes confiables separados por comas (por defecto: http://localhost:3000,gestinovo://). Los mismos orígenes web
# (http/https, sin ruta ni «*») son los únicos que reciben CORS con credenciales. Para el web local: http://localhost:3001
AUTH_TRUSTED_ORIGINS=
# Destino web de los enlaces de correo (DT-10); opcional mientras no existan los clientes
APP_WEB_URL=

# Cloudflare R2: bucket PRIVADO de documentos (DT-18). Token con Object Read & Write limitado a ese bucket.
# PEI no usa URLs públicas de R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Resend (DT-9): correos de verificación y recuperación de contraseña
RESEND_API_KEY=
EMAIL_FROM=
