# Variables del backend de PEI. Copiar a .env y completar; nunca versionar valores reales.

# PostgreSQL (Neon)
DATABASE_URL=

# Better Auth
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Orígenes confiables separados por comas (por defecto: http://localhost:3000,gestinovo://). Los mismos orígenes web
# (http/https, sin ruta ni «*») son los únicos que reciben CORS con credenciales. Para el web local: http://localhost:3001
AUTH_TRUSTED_ORIGINS=
# Destino web de los enlaces de correo (DT-10); opcional mientras no existan los clientes
APP_WEB_URL=

# Cloudflare R2: bucket PRIVADO de documentos (DT-18). Token con Object Read & Write limitado a ese bucket.
# PEI no usa URLs públicas de R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Resend (DT-9): correos de verificación y recuperación de contraseña
RESEND_API_KEY=
EMAIL_FROM=

# M08 (AP-16): reserva de citas. Solo "true" la activa; en producción debe quedar sin definir o en false hasta integrar pagos.
APPOINTMENTS_BOOKING_ENABLED=false

# Payments: Stripe es el proveedor ACTIVO de ambos checkouts (consulta y medicamentos). Sin estas variables el backend
# arranca, pero ningún cobro es posible (falla cerrada).
# STRIPE_ENV: test | live. En Stripe el prefijo de la clave SÍ distingue el modo: con STRIPE_ENV=test la clave debe ser
# sk_test_... (o una restringida rk_test_...); una clave del otro modo detiene el arranque. live exige STRIPE_ALLOW_LIVE=true
# y NODE_ENV distinto de test. El periodo académico es solo modo de prueba: no se usan credenciales ni dinero reales.
# STRIPE_SECRET_KEY vive solo en el backend y nunca se versiona. La clave publicable (pk_test_...) es del frontend.
STRIPE_ENV=
STRIPE_SECRET_KEY=
STRIPE_ALLOW_LIVE=
# Webhooks de Stripe (POST /webhooks/stripe). Secreto de firma del endpoint (whsec_...): el del panel de Stripe
# (Developers → Webhooks → el endpoint → Signing secret) o el que imprime "stripe listen" en local. Sin él se rechazan
# todas las notificaciones. Nunca lo versiones. STRIPE_WEBHOOK_TOLERANCE_SECONDS: antigüedad máxima de la marca de tiempo
# firmada (opcional; vacía = 300 s, el valor que recomienda Stripe).
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Worker de recuperación de webhooks (H-6, etapa 1). Reprocesa cada intervalo, y una vez al arrancar, los eventos
# `received` no despachados, los `failed` con intentos disponibles y los `processing` abandonados. Un candado consultivo
# de PostgreSQL impide que dos instancias barran a la vez. La vía rápida (despacho inmediato) no cambia.
# DESACTIVADO por defecto y debe SEGUIR DESACTIVADO (también en producción) mientras estén pendientes R-3 y R-4 de H-6:
# los reintentos aún no tienen backoff y los errores permanentes pueden consumir los 8 intentos.
# PAYMENTS_WEBHOOK_RETRY_WORKER_ENABLED: true | false (vacía = false).
# PAYMENTS_WEBHOOK_RETRY_INTERVAL_SECONDS: entero de 5 a 3600 (vacía = 60).
PAYMENTS_WEBHOOK_RETRY_WORKER_ENABLED=false
PAYMENTS_WEBHOOK_RETRY_INTERVAL_SECONDS=60

# Mercado Pago: DESACTIVADO. Su código se conserva (infrastructure/mercadopago), pero el backend ya NO lee estas variables
# ni expone /webhooks/mercado-pago. Se dejan documentadas solo para comparar o recuperar información; déjalas vacías.
MERCADO_PAGO_ENV=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_ALLOW_PRODUCTION=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=

# Videoconsulta: Cloudflare RealtimeKit (solo backend; nunca versiones valores reales). Sin ninguna variable, la
# videollamada no está disponible (la sala de espera sí). Una configuración parcial o inválida también la deja sin
# proveedor y lo registra en el log, solo con nombres de variables.
# CLOUDFLARE_API_TOKEN: permiso «Realtime» o «Realtime Admin». Los presets deben existir en la aplicación; no tienen
# valor por omisión. CLOUDFLARE_REALTIME_TIMEOUT_MS: 1000–30000; vacía, 8000.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_REALTIME_PRESET_DOCTOR=
CLOUDFLARE_REALTIME_PRESET_PATIENT=
CLOUDFLARE_REALTIME_TIMEOUT_MS=
